    "test": "tsx --test src/**/*.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@hocuspocus/extension-database": "^4.4.0",
    "@hocuspocus/server": "^4.4.0",
    "pg": "^8.22.0",
    "yjs": "^13.6.31"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "@types/pg": "^8.15.6",
    "tsx": "^4.20.6",
    "typescript": "~6.0.0"
  }
}
