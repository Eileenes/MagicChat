    </section>
  </main>
  <SiteFooter />
  <script>
    const revealItems = Array.from(new Set(Array.from(document.querySelectorAll<HTMLElement>('.scene-hero .scene-content > *, .scene-why .scene-text-block, .scene-why .pain-carousel, .scene-solution .scene-text-block, .feature-explorer, .comparison-heading, .comparison-panel, .faq-inner, .scene-download .scene-content > *, .footer-grid > *'))));
    revealItems.forEach((item, index) => { item.classList.add('motion-reveal'); item.style.setProperty('--reveal-delay', `${(index % 5) * 70}ms`); });
    if ('IntersectionObserver' in window) { const observer = new IntersectionObserver((entries) => entries.forEach((entry) => { if (entry.isIntersecting) { entry.target.classList.add('is-visible'); observer.unobserve(entry.target); } }), { threshold: 0.16 }); revealItems.forEach((item) => observer.observe(item)); } else revealItems.forEach((item) => item.classList.add('is-visible'));
    const featurePreviews = Array.from(document.querySelectorAll<HTMLElement>('[data-feature-preview]'));
    const featurePages = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-feature-page]'));
    const featureEmpty = document.querySelector<HTMLElement>('[data-feature-empty]');
    const featureExplorer = document.querySelector<HTMLElement>('.feature-explorer');
    let activeFeatureIndex = 0;
    let featureAutoplay: number | undefined;
    let featureVisible = !('IntersectionObserver' in window);
    const featureDemoTimers = new WeakMap<HTMLElement, number[]>();
    const featureDemoStartDelay = 1000;
    const featureDemoClasses = ['is-demo-clicking', 'is-demo-sent', 'is-demo-processing', 'is-demo-streaming', 'is-demo-complete'];
    const stopFeatureDemo = (preview: HTMLElement) => {
      featureDemoTimers.get(preview)?.forEach((timer) => window.clearTimeout(timer));
      featureDemoTimers.delete(preview);
      featureDemoClasses.forEach((className) => preview.classList.remove(className));
    };
    const runFeatureDemo = (preview: HTMLElement) => {
      stopFeatureDemo(preview);
      const prompt = preview.dataset.featurePrompt ?? '';
      const processLabel = preview.dataset.featureProcess ?? '正在处理中';
      const response = preview.dataset.featureResponse ?? '';
      const resultLabel = preview.dataset.featureResult ?? '已完成';
      const shouldStream = preview.dataset.featureStream === 'true' && response.length > 0;
      const composerText = preview.querySelector<HTMLElement>('[data-composer-text]');
      const userRequest = preview.querySelector<HTMLElement>('[data-user-request]');
      const assistantStatus = preview.querySelector<HTMLElement>('[data-assistant-status]');
      const assistantResponse = preview.querySelector<HTMLElement>('[data-assistant-response]');
      const assistantResult = preview.querySelector<HTMLElement>('[data-assistant-result]');
      const chatHistory = preview.querySelector<HTMLElement>('.app-chat-history');
      if (!composerText || !userRequest || !assistantStatus || !assistantResponse || !assistantResult) return;
      const timers: number[] = [];
      featureDemoTimers.set(preview, timers);
      const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const later = (callback: () => void, delay: number) => { timers.push(window.setTimeout(callback, delay)); };
      const scrollHistory = () => { if (chatHistory) chatHistory.scrollTop = chatHistory.scrollHeight; };
      composerText.textContent = reducedMotion ? prompt : '';
      userRequest.textContent = prompt;
      assistantStatus.textContent = `AI 助理 ${processLabel}`;
      assistantResponse.textContent = '';
      assistantResult.textContent = '待处理';
      if (reducedMotion) {
        preview.classList.add('is-demo-sent', 'is-demo-processing');
        if (shouldStream) {
          preview.classList.add('is-demo-streaming', 'is-demo-complete');
          assistantResponse.textContent = response;
          assistantResult.textContent = resultLabel;
        }
        scrollHistory();
        return;
      }
      const typePrompt = (position: number) => {
        composerText.textContent = prompt.slice(0, position);
        if (position < prompt.length) later(() => typePrompt(position + 1), 14);
        else later(() => {
          preview.classList.add('is-demo-clicking');
          later(() => {
            preview.classList.remove('is-demo-clicking');
            preview.classList.add('is-demo-sent', 'is-demo-processing');
            composerText.textContent = '已发送';
            assistantStatus.textContent = `AI 助理 ${processLabel}`;
            scrollHistory();
          }, 460);
        }, 120);
      };
      later(() => typePrompt(0), featureDemoStartDelay);
      if (!shouldStream) return;
      later(() => {
        preview.classList.add('is-demo-streaming');
        assistantResponse.textContent = '';
        assistantResult.textContent = '处理中';
        const streamResponse = (position: number) => {
          assistantResponse.textContent = response.slice(0, position);
          scrollHistory();
          if (position < response.length) later(() => streamResponse(position + 1), 30);
          else {
            preview.classList.add('is-demo-complete');
            assistantResult.textContent = resultLabel;
          }
        };
        streamResponse(0);
      }, featureDemoStartDelay + 1850);
    };
    const showFeature = (index: number) => {
      activeFeatureIndex = (index + featurePreviews.length) % featurePreviews.length;
      featurePreviews.forEach((preview, previewIndex) => { const active = previewIndex === activeFeatureIndex; preview.classList.toggle('is-active', active); preview.hidden = !active; if (active) runFeatureDemo(preview); else stopFeatureDemo(preview); });
      featurePages.forEach((page, pageIndex) => { const active = pageIndex === activeFeatureIndex; page.classList.toggle('is-active', active); page.setAttribute('aria-selected', String(active)); });
      if (featureEmpty) featureEmpty.hidden = true;
    };
    const stopFeatureAutoplay = () => { if (featureAutoplay !== undefined) { window.clearInterval(featureAutoplay); featureAutoplay = undefined; } };
    const startFeatureAutoplay = () => {
      stopFeatureAutoplay();
      if (!featureVisible || window.matchMedia('(prefers-reduced-motion: reduce)').matches || document.hidden || featureExplorer?.matches(':hover, :focus-within')) return;
      featureAutoplay = window.setInterval(() => showFeature(activeFeatureIndex + 1), 5000);
    };
    featurePages.forEach((page, index) => page.addEventListener('click', () => { showFeature(index); startFeatureAutoplay(); }));
    featureExplorer?.addEventListener('mouseenter', stopFeatureAutoplay);
    featureExplorer?.addEventListener('mouseleave', startFeatureAutoplay);
    featureExplorer?.addEventListener('focusin', stopFeatureAutoplay);
    featureExplorer?.addEventListener('focusout', () => window.setTimeout(startFeatureAutoplay));
    document.addEventListener('visibilitychange', () => { if (document.hidden) stopFeatureAutoplay(); else startFeatureAutoplay(); });
    window.matchMedia('(prefers-reduced-motion: reduce)').addEventListener('change', () => { if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) stopFeatureAutoplay(); else startFeatureAutoplay(); });
    if (featureExplorer && 'IntersectionObserver' in window) new IntersectionObserver((entries) => entries.forEach((entry) => { featureVisible = entry.isIntersecting; if (featureVisible) startFeatureAutoplay(); else stopFeatureAutoplay(); }), { threshold: 0.3 }).observe(featureExplorer);
    showFeature(0);
    startFeatureAutoplay();
    const painCarousel = document.querySelector<HTMLElement>('[data-pain-carousel]');
    const painViewport = painCarousel?.querySelector<HTMLElement>('.pain-carousel-viewport');
    const painTrack = painCarousel?.querySelector<HTMLElement>('[data-pain-track]');
    const painSlides = Array.from(painCarousel?.querySelectorAll<HTMLElement>('[data-pain-slide]') ?? []);
    const painPages = Array.from(painCarousel?.querySelectorAll<HTMLButtonElement>('[data-pain-pagination]') ?? []);
    const painPrevious = painCarousel?.querySelector<HTMLButtonElement>('[data-pain-previous]');
    const painNext = painCarousel?.querySelector<HTMLButtonElement>('[data-pain-next]');
    if (painCarousel && painTrack && painSlides.length > 1) {
      let activePainIndex = 0;
      let painAutoplay: number | undefined;
      let painPointerStart: number | undefined;
      let painPointerControl = false;
      let painCarouselVisible = !('IntersectionObserver' in window);
      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
      const showPainSlide = (index: number) => {
        activePainIndex = (index + painSlides.length) % painSlides.length;
        painTrack.style.setProperty('--pain-slide-index', String(activePainIndex));
        painSlides.forEach((slide, slideIndex) => { slide.setAttribute('aria-hidden', String(slideIndex !== activePainIndex)); });
        painPages.forEach((page, pageIndex) => { const active = pageIndex === activePainIndex; page.classList.toggle('is-active', active); page.setAttribute('aria-selected', String(active)); });
      };
      const stopPainAutoplay = () => { if (painAutoplay) window.clearInterval(painAutoplay); painAutoplay = undefined; painCarousel.classList.remove('is-autoplaying'); };
      const startPainAutoplay = () => {
        stopPainAutoplay();
        if (reduceMotion.matches || document.hidden || !painCarouselVisible || painCarousel.matches(':focus-within')) return;
        void painCarousel.offsetWidth;
        painCarousel.classList.add('is-autoplaying');
        painAutoplay = window.setInterval(() => showPainSlide(activePainIndex + 1), 3000);
      };
      const selectPainSlide = (index: number) => {
        if (painPointerControl && document.activeElement instanceof HTMLElement) document.activeElement.blur();
        painPointerControl = false;
        showPainSlide(index);
        startPainAutoplay();
      };
      const markPainPointerControl = () => { painPointerControl = true; };
      painPrevious?.addEventListener('pointerdown', markPainPointerControl);
      painNext?.addEventListener('pointerdown', markPainPointerControl);
      painPages.forEach((page) => page.addEventListener('pointerdown', markPainPointerControl));
      painPrevious?.addEventListener('click', () => selectPainSlide(activePainIndex - 1));
      painNext?.addEventListener('click', () => selectPainSlide(activePainIndex + 1));
      painPages.forEach((page, index) => page.addEventListener('click', () => selectPainSlide(index)));
      painCarousel.addEventListener('focusin', stopPainAutoplay);
      painCarousel.addEventListener('focusout', () => window.setTimeout(startPainAutoplay));
      painViewport?.addEventListener('pointerdown', (event) => { if (!event.isPrimary) return; painPointerStart = event.clientX; stopPainAutoplay(); });
      painViewport?.addEventListener('pointerup', (event) => {
        if (painPointerStart === undefined || !event.isPrimary) return;
        const distance = event.clientX - painPointerStart;
        painPointerStart = undefined;
        if (Math.abs(distance) >= 48) showPainSlide(activePainIndex + (distance < 0 ? 1 : -1));
        startPainAutoplay();
      });
      painViewport?.addEventListener('pointercancel', () => { painPointerStart = undefined; startPainAutoplay(); });
      document.addEventListener('visibilitychange', () => { if (document.hidden) stopPainAutoplay(); else startPainAutoplay(); });
      reduceMotion.addEventListener('change', startPainAutoplay);
      if ('IntersectionObserver' in window) new IntersectionObserver((entries) => entries.forEach((entry) => { painCarouselVisible = entry.isIntersecting; if (painCarouselVisible) startPainAutoplay(); else stopPainAutoplay(); }), { threshold: 0.35 }).observe(painCarousel);
      showPainSlide(0);
      startPainAutoplay();
    }
    if (window.matchMedia('(hover: hover)').matches) document.querySelectorAll<HTMLDetailsElement>('.faq-list details').forEach((item) => {
      item.addEventListener('mouseenter', () => { item.open = true; });
      item.addEventListener('mouseleave', () => { if (!item.matches(':focus-within')) item.open = false; });
    });
    if (window.matchMedia('(hover: hover)').matches) document.querySelectorAll<HTMLDetailsElement>('.download-menu').forEach((item) => {
      item.addEventListener('mouseenter', () => { item.open = true; });
      item.addEventListener('mouseleave', () => { if (!item.matches(':focus-within')) item.open = false; });
    });
  </script>
</BaseLayout>
