---
import { Icon } from 'astro-icon/components';
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteFooter from '../components/SiteFooter.astro';
import SiteHeader from '../components/SiteHeader.astro';

const title = '即应｜开源的企业 AI 工作空间';
const description = '即应把团队沟通、办公 AI 助理、项目和任务放进同一个工作空间。项目开源，支持免费私有化部署，可连接自己的模型和业务系统。';
const siteOrigin = Astro.site ?? Astro.url.origin;
const pageUrl = new URL(import.meta.env.BASE_URL, siteOrigin).href;
const logoUrl = new URL(`${import.meta.env.BASE_URL}favicon.webp`, siteOrigin).href;

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    name: '即应',
    url: pageUrl,
    logo: logoUrl,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'SoftwareApplication',
    name: '即应',
    alternateName: 'MagicChat',
    applicationCategory: 'BusinessApplication',
    operatingSystem: 'Web, macOS, Windows, Linux, iOS, Android',
    description,
    url: pageUrl,
  },
];

const capabilities = [
  {
    number: '01',
    label: '查找信息',
    title: '从会话和工作数据中找到答案',
    body: '在用户授权范围内读取聊天记录和附件，查询联系人、群聊、项目与任务，不必手动翻找散落的信息。',
    icon: 'tabler:search',
    tone: 'teal',
  },
  {
    number: '02',
    label: '完成沟通',
    title: '联系成员，并等待事情有结果',
    body: '办公 AI 助理可以按明确授权发送消息、创建群聊、添加成员，并在收到回复后继续完成当前工作。',
    icon: 'tabler:message-circle',
    tone: 'violet',
  },
  {
    number: '03',
    label: '管理工作',
    title: '把讨论整理成项目和任务',
    body: '查询、创建和修改项目与任务，补充负责人、日期、标签和提醒；写入前会先查重并请你确认。',
    icon: 'tabler:list-check',
    tone: 'coral',
  },
];

const platformCapabilities = [
  {
    number: '01',
    label: '独立身份',
    title: 'AI 和应用也是协作成员',
    body: '应用可以进入单聊、群聊和话题，接收消息并发送选择、图表、文件和卡片，不需要伪装成用户。',
    icon: 'tabler:robot',
    tone: 'teal',
  },
  {
    number: '02',
    label: '权限边界',
    title: '能做什么，由企业和用户决定',
    body: '用户、办公 AI 助理和第三方应用拥有各自的身份与权限。敏感写操作需要授权，重要变更需要确认。',
    icon: 'tabler:shield-check',
    tone: 'violet',
  },
  {
    number: '03',
    label: '开放扩展',
    title: '连接自己的模型和业务系统',
    body: '通过应用接口和 MCP 扩展能力，不被单一模型或固定工具绑定，让现有系统进入同一个协作空间。',
    icon: 'tabler:users',
    tone: 'coral',
  },
];

const steps = [
  ['01', '提出请求', '直接在会话里说明目标。相关消息、文件和关联项目成为本次工作的参考。'],
  ['02', '确认对象', '办公 AI 助理查询真实的联系人、会话、项目或任务，遇到重名和多种选择时先向你确认。'],
  ['03', '检查变更', '创建或修改任务前展示完整参数，通过选择消息完成二次确认，不把最初的指令当作授权。'],
  ['04', '执行并交付', '操作完成后把消息、图表、文件或项目与任务卡片直接发回会话，结果清楚可查。'],
];
---

<BaseLayout title={title} description={description} schema={schema}>
  <SiteHeader />
  <main id="main-content">
    <section class="hero" aria-labelledby="hero-title">
      <div class="container hero-grid">
        <div class="hero-copy">
          <span class="eyebrow"><span class="status-dot"></span>开源 · 免费私有化部署</span>
          <h1 id="hero-title">和 AI 一起工作，<br /><mark>也掌握自己的数据</mark></h1>
          <p>即应把团队沟通、办公 AI 助理、项目和任务放进同一个工作空间。你可以直接使用，也可以部署到自己的服务器，连接自己的模型和业务系统。</p>
          <div class="hero-actions">
            <a class="button button-primary" href="https://chat.chaitin.net/" target="_blank" rel="noreferrer">
              开始使用 <Icon name="tabler:arrow-right" size={17} aria-hidden="true" />
            </a>
            <a class="button button-secondary" href="https://github.com/chaitin/MagicChat" target="_blank" rel="noopener noreferrer">
              查看源码 <Icon name="tabler:brand-github-filled" size={17} aria-hidden="true" />
            </a>
          </div>
          <ul class="hero-points" aria-label="产品特点">
            <li><Icon name="tabler:check" size={14} aria-hidden="true" /> AGPL v3 开源</li>
            <li><Icon name="tabler:check" size={14} aria-hidden="true" /> Docker 私有部署</li>
            <li><Icon name="tabler:check" size={14} aria-hidden="true" /> 自主连接 AI 模型</li>
          </ul>
        </div>

        <div class="product-scene" aria-label="即应产品界面示意图">
          <div class="product-window">
            <aside class="app-rail" aria-hidden="true">
              <img src={`${import.meta.env.BASE_URL}favicon.webp`} width="34" height="34" alt="" />
              <span class="rail-icon active"><Icon name="tabler:message-circle" size={16} /></span>
              <span class="rail-icon"><Icon name="tabler:users" size={16} /></span>
              <span class="rail-icon"><Icon name="tabler:layout-kanban" size={16} /></span>
              <span class="rail-avatar">你</span>
            </aside>
            <aside class="conversation-list" aria-hidden="true">
              <strong>协作空间</strong>
              <div class="mock-search"><Icon name="tabler:search" size={12} /> 搜索会话</div>
              <small>置顶会话</small>
              <div class="conversation active"><span class="avatar ai">AI</span><div><b>办公助手</b><em>有 2 项任务待确认</em></div></div>
              <div class="conversation"><span class="avatar violet">产</span><div><b>产品研发群</b><em>林夏：范围已确认</em></div></div>
              <div class="conversation"><span class="avatar coral">设</span><div><b>设计评审</b><em>2 个新文件</em></div></div>
            </aside>
            <section class="chat-panel" aria-hidden="true">
              <header><div><b>办公 AI 助理</b><small>为你查找信息并执行工作</small></div><span class="online">在线</span></header>
              <div class="message-flow">
                <div class="message user-message"><div><small>你 · 09:41</small><p>把本周发布讨论里的待办整理出来。</p></div></div>
                <div class="message assistant-message">
                  <span class="avatar ai">AI</span>
                  <div><small>办公助手 · 09:42</small><p>我找到了 3 项待办，其中后两项尚未创建任务。</p></div>
                </div>
                <div class="task-summary">
                  <div class="task-heading"><span><Icon name="tabler:file-text" size={13} /> 发布准备</span><b>3 项</b></div>
                  <div class="task-row"><Icon name="tabler:check" size={12} /> 确认桌面端发布范围 <span>已完成</span></div>
                  <div class="task-row"><span class="task-open"></span> 补齐更新说明 <span>待创建</span></div>
                  <div class="task-row"><span class="task-open"></span> 完成多端回归 <span>待创建</span></div>
                </div>
              </div>
              <div class="composer">给办公助手发消息… <span><Icon name="tabler:paperclip" size={13} /><Icon name="tabler:microphone" size={13} /><i><Icon name="tabler:send" size={12} /></i></span></div>
            </section>
          </div>
        </div>
      </div>
    </section>

    <div class="overview-bar" aria-label="即应产品特点">
      <div class="container overview-grid">
        <div><strong>开源</strong><span>AGPL v3</span></div>
        <div><strong>免费部署</strong><span>运行在自己的服务器</span></div>
        <div><strong>自主模型</strong><span>连接企业选择的 AI</span></div>
        <div><strong>全平台</strong><span>Web、桌面与移动端</span></div>
      </div>
    </div>

    <section class="section product-section" id="product">
      <div class="container">
        <div class="section-heading reveal">
          <div><span class="eyebrow">一个工作空间</span><h2>沟通、AI 和执行，<br />不必来回切换</h2></div>
          <p>从日常聊天开始，在同一个地方找到信息、联系成员，并把结果继续放进项目和任务。</p>
        </div>

        <div class="product-demo reveal">
          <div class="demo-tabs" role="tablist" aria-label="即应产品能力">
            <button class="demo-tab active" type="button" role="tab" aria-selected="true" aria-controls="demo-chat" data-demo="chat">团队沟通</button>
            <button class="demo-tab" type="button" role="tab" aria-selected="false" aria-controls="demo-agent" data-demo="agent">办公 AI 助理</button>
            <button class="demo-tab" type="button" role="tab" aria-selected="false" aria-controls="demo-project" data-demo="project">项目与任务</button>
          </div>
          <div class="demo-panels">
            <article class="demo-panel active" id="demo-chat" role="tabpanel" data-panel="chat">
              <div class="demo-copy"><span>01 · 团队沟通</span><h3>人与 AI，在同一个会话里协作</h3><p>私聊、群聊和话题统一承载文字、Markdown、图片、文件与语音；引用、转发、提及和回应让讨论保持清楚。</p><ul><li>私聊、群聊与话题</li><li>多类型消息</li><li>记录与通讯录搜索</li></ul></div>
              <div class="demo-visual"><div class="topic-ui"><b># 产品上线准备</b><div><span class="avatar violet">林</span><p><strong>林夏</strong>桌面端发布范围已经确认，更新说明还差最后一版。</p></div><div><span class="avatar ai">AI</span><p><strong>办公助手</strong>我可以读取本次讨论，整理待办并在确认后创建任务。</p></div><label>回复当前话题…</label></div></div>
            </article>
            <article class="demo-panel" id="demo-agent" role="tabpanel" data-panel="agent" hidden>
              <div class="demo-copy"><span>02 · 办公 AI 助理</span><h3>不只给出答案，也能把事情办下去</h3><p>在明确授权下查询工作信息、完成沟通、管理项目与任务，并用选择、图表、文件和卡片交付结果。</p><ul><li>读取会话和附件</li><li>联系成员并等待回复</li><li>创建项目和任务</li></ul></div>
              <div class="demo-visual"><div class="agent-list"><div><span class="agent-face teal"><Icon name="tabler:search" size={18} /></span><p><b>查找信息</b><small>会话、联系人、项目和任务</small></p><em>按权限读取</em></div><div><span class="agent-face violet"><Icon name="tabler:message-circle" size={18} /></span><p><b>完成沟通</b><small>发送消息、建群并等待回复</small></p><em>明确授权</em></div><div><span class="agent-face coral"><Icon name="tabler:list-check" size={18} /></span><p><b>管理工作</b><small>查询、创建和修改任务</small></p><em>写入前确认</em></div></div></div>
            </article>
            <article class="demo-panel" id="demo-project" role="tabpanel" data-panel="project" hidden>
              <div class="demo-copy"><span>03 · 项目与任务</span><h3>让讨论有归属，让工作有负责人</h3><p>个人工作区和协作项目承接后续工作，任务记录状态、优先级、负责人、日期、标签和提醒。</p><ul><li>项目关联群聊</li><li>任务提醒与卡片</li><li>看板、列表、日历和甘特图</li></ul></div>
              <div class="demo-visual"><div class="mini-board"><section><b>待处理 <em>2</em></b><p>补齐上线说明<small>今天 · 林夏</small></p><p>检查下载页<small>周四 · 陈屿</small></p></section><section><b>进行中 <em>1</em></b><p>发布前回归测试<small>周五 · QA</small></p></section><section><b>已完成 <em>1</em></b><p>确认版本范围<small>今天 · 完成</small></p></section></div></div>
            </article>
          </div>
        </div>
      </div>
    </section>

    <section class="section capability-section" id="capabilities">
      <div class="container">
        <div class="section-heading reveal">
          <div><span class="eyebrow">办公 AI 助理</span><h2>从回答问题，<br />到实际完成工作</h2></div>
          <p>能力直接发生在团队使用的会话、通讯录、项目和任务中，不需要把信息复制到另一个 AI 对话框。</p>
        </div>
        <div class="capability-grid">
          {capabilities.map(({ number, label, title: itemTitle, body, icon, tone }, index) => (
            <article class:list={['capability-card', tone, 'reveal']} style={`--delay: ${index * 70}ms`}>
              <div class="card-top"><span>{number} · {label}</span><Icon name={icon} size={24} stroke-width={1.8} aria-hidden="true" /></div>
              <div><h3>{itemTitle}</h3><p>{body}</p></div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="section workflow-section" id="workflow">
      <div class="container">
        <div class="section-heading reveal">
          <div><span class="eyebrow">清楚可控</span><h2>AI 可以行动，<br />但不会替你越权决定</h2></div>
          <p>每一次读取和操作都在真实权限范围内完成。遇到多个对象、任务写入或重要变更时，先让你看清再执行。</p>
        </div>
        <div class="workflow-layout">
          <aside class="workflow-note reveal"><span class="note-icon"><Icon name="tabler:shield-check" size={22} /></span><h3>重要操作，由你确认</h3><p>办公 AI 助理使用独立身份，通过当前用户的明确授权执行工作。第三方应用不会自动继承创建者权限。</p><div><span>请求</span><Icon name="tabler:arrow-right" size={13} /><span>查询</span><Icon name="tabler:arrow-right" size={13} /><span>确认</span><Icon name="tabler:arrow-right" size={13} /><span>执行</span></div></aside>
          <div class="workflow-steps">
            {steps.map(([number, stepTitle, body], index) => (
              <article class="workflow-step reveal" style={`--delay: ${index * 70}ms`}><span>{number}</span><div><h3>{stepTitle}</h3><p>{body}</p></div></article>
            ))}
          </div>
        </div>
      </div>
    </section>

    <section class="section assistant-section" id="open-source">
      <div class="container assistant-band reveal">
        <div class="assistant-copy"><span class="eyebrow eyebrow-light">开源与私有化</span><h2>部署在自己的环境，<br />连接自己的模型</h2><p>即应基于 AGPL v3 开源，软件本身可以免费私有化部署。企业自行管理服务、数据、模型和集成方式，不被固定 SaaS 平台绑定。</p><div class="trust-points"><span><Icon name="tabler:brand-github-filled" size={17} /> 源码公开可审查</span><span><Icon name="tabler:shield-check" size={17} /> 数据由部署方掌控</span></div></div>
        <aside class="decision-panel" aria-label="即应私有化部署特点">
          <header><span><span class="assistant-avatar"><Icon name="tabler:layout-kanban" size={17} /></span>自己的 AI 工作空间</span><em>开源免费</em></header>
          <h3>从源码到企业自己的服务</h3>
          <dl><div><dt>部署</dt><dd>使用 Docker 部署到自己的服务器。</dd></div><div><dt>模型</dt><dd>配置企业选择的大模型服务。</dd></div><div><dt>扩展</dt><dd>通过 MCP 和应用接口连接已有业务系统。</dd></div></dl>
          <div class="decision-actions"><a href="https://github.com/chaitin/MagicChat" target="_blank" rel="noopener noreferrer">查看源码</a><a href="https://github.com/chaitin/MagicChat" target="_blank" rel="noopener noreferrer">开始部署</a></div>
        </aside>
      </div>
    </section>

    <section class="section capability-section platform-section" id="platform">
      <div class="container">
        <div class="section-heading reveal">
          <div><span class="eyebrow">开放协作平台</span><h2>让团队成员、AI 和应用，<br />在同一个空间工作</h2></div>
          <p>即应提供的不只是一个内置助手，也是一套可扩展的协作基础，让企业现有应用以清晰身份参与工作。</p>
        </div>
        <div class="capability-grid">
          {platformCapabilities.map(({ number, label, title: itemTitle, body, icon, tone }, index) => (
            <article class:list={['capability-card', tone, 'reveal']} style={`--delay: ${index * 70}ms`}>
              <div class="card-top"><span>{number} · {label}</span><Icon name={icon} size={24} stroke-width={1.8} aria-hidden="true" /></div>
              <div><h3>{itemTitle}</h3><p>{body}</p></div>
            </article>
          ))}
        </div>
      </div>
    </section>
  </main>
  <SiteFooter />

  <script>
    const tabs = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-demo]'));
    const panels = Array.from(document.querySelectorAll<HTMLElement>('[data-panel]'));
    tabs.forEach((tab) => {
      tab.addEventListener('click', () => {
        const target = tab.dataset.demo;
        tabs.forEach((item) => {
          const active = item === tab;
          item.classList.toggle('active', active);
          item.setAttribute('aria-selected', String(active));
        });
        panels.forEach((panel) => {
          const active = panel.dataset.panel === target;
          panel.classList.toggle('active', active);
          panel.hidden = !active;
        });
      });
    });

    const revealItems = document.querySelectorAll<HTMLElement>('.reveal');
    if (!('IntersectionObserver' in window)) {
      revealItems.forEach((item) => item.classList.add('visible'));
    } else {
      const observer = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          entry.target.classList.add('visible');
          observer.unobserve(entry.target);
        });
      }, { threshold: 0.12, rootMargin: '0px 0px -36px' });
      revealItems.forEach((item) => observer.observe(item));
    }
  </script>
</BaseLayout>
