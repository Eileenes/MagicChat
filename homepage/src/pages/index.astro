---
import { Icon } from 'astro-icon/components';
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteFooter from '../components/SiteFooter.astro';
import SiteHeader from '../components/SiteHeader.astro';

const title = '即应｜AI 时代的团队协作入口';
const description = '即应是一款开源的即时通讯工具，连接消息、知识与任务，让 Agent 深度融入工作流，成为真正能参与协作、推动执行的数字员工。';
const siteOrigin = Astro.site ?? Astro.url.origin;
const pageUrl = new URL(import.meta.env.BASE_URL, siteOrigin).href;
const logoUrl = new URL(`${import.meta.env.BASE_URL}favicon.webp`, siteOrigin).href;

const schema = [
  { '@context': 'https://schema.org', '@type': 'Organization', name: '即应', url: pageUrl, logo: logoUrl },
  { '@context': 'https://schema.org', '@type': 'SoftwareApplication', name: '即应', alternateName: 'MagicChat', applicationCategory: 'BusinessApplication', operatingSystem: 'Web, macOS, Windows, Linux, iOS, Android', description, url: pageUrl },
];

const painPoints = [
  ['01', '沟通与上下文严重割裂', '消息、文件、成员和项目分散在不同工具里。每次寻求 AI 或同事协助，都不得不重新翻找资料、复制背景、重复解释需求。'],
  ['02', '传统 AI 缺乏协同记忆', '普通 AI 助手仅停留在“一问一答”的单机对话框。看不见团队成员、缺乏长期项目上下文、无法跨会话追踪，答完即结束。'],
  ['03', '信息过载与重复爬楼', '每日面对数百条群聊消息与邮件，人工爬楼抓重点耗时耗力；同一个业务背景需要向不同部门的干系人反复口述交代。'],
  ['04', '讨论与行动断层严重', '会议和聊天中达成的共识缺乏自动跟进机制，仍需人工手动整理待办、指派负责人并反复催办，沟通经常止于“收到”。'],
  ['05', '数据隐私与风控隐患', '公共 AI 无法保障企业核心业务数据的私有可控，且缺乏对敏感数据读取隔离及高风险操作（如发公告、改状态）的人工审核屏障。'],
];

const capabilities = [
  ['全域感知·记得住', '上下文自动沉淀在会话、任务与项目日志中，跨会话长期记忆，告别每次对话重新交代背景的繁琐。', '上下文工作台', 'tabler:brain', '5 个关联会话'],
  ['主动协同·会办事', '主动梳理待办、自动起草通知、智能催办跟进，将零散沟通自动转化为可执行、有反馈的闭环行动。', '项目推进面板', 'tabler:checkbox', '3 项待跟进'],
  ['严密风控·守边界', '严格遵循企业级权限体系，敏感数据读取可控，所有重要写操作与外部通知均需经由人工明确确认。', '权限确认中心', 'tabler:shield-check', '需确认 2 项'],
  ['自主可控·易扩展', '支持企业自建环境私有化部署，核心代码开源，可自由接入企业已有大模型、API 及业务系统。', '扩展连接中心', 'tabler:plug-connected', '6 个已连接'],
];

const featureVisuals = [
  {
    inboxTitle: '消息',
    inboxTabs: ['全部', '未读', '群聊'],
    threads: [
      ['AI 助理', 'assistant', 'AI', '已关联 5 个上下文', true],
      ['创新产品', 'team', '团', '项目讨论与任务动态', false],
      ['项目资料', 'doc', '文', '已同步更新', false],
    ],
    chat: ['AI 助理', 'assistant', 'AI', '跨会话上下文', 'tabler:brain'],
    assistant: 'AI 助理',
    prompt: '@AI 助理，帮我把产品项目群的历史信息总结一下发给李XX',
    processLabel: '正在整理中',
    response: '已整理产品项目群的历史信息，并将摘要发给李XX。',
    responseStatus: '已发送',
    streamResponse: false,
  },
  {
    inboxTitle: '任务',
    inboxTabs: ['待办', '进行中', '已完成'],
    threads: [
      ['创新产品', 'team', '团', '3 项待跟进', true],
      ['AI 助理', 'assistant', 'AI', '正在推进任务', false],
      ['项目资料', 'doc', '文', '待同步 2 项', false],
    ],
    chat: ['创新产品', 'team', '团', '项目推进 · 8 人', 'tabler:checkbox'],
    assistant: 'AI 助理',
    prompt: '@AI 助理，给@xxx创建个任务，星期三前完成销售报表的制作',
    processLabel: '正在创建中',
    response: '任务创建成功',
    responseStatus: '已创建',
    streamResponse: true,
  },
  {
    inboxTitle: '权限',
    inboxTabs: ['待确认', '已通过', '审计'],
    threads: [
      ['权限确认中心', 'permission', '权', '待人工确认', true],
      ['项目资料', 'doc', '文', '敏感资料 4 项', false],
      ['AI 助理', 'assistant', 'AI', '策略已同步', false],
    ],
    chat: ['权限确认中心', 'permission', '权', '待人工确认', 'tabler:shield-check'],
    assistant: 'AI 助理',
    prompt: '@AI 助理，查看一下XXX项目的情况',
    processLabel: '正在查找中',
    response: '当前你不在项目中无法查看',
    responseStatus: '已拦截',
    streamResponse: true,
  },
  {
    inboxTitle: '连接',
    inboxTabs: ['全部', '已连接', '待接入'],
    threads: [
      ['扩展服务', 'connect', '扩', '6 个已连接', true],
      ['模型服务', 'team', '模', 'API 运行正常', false],
      ['AI 助理', 'assistant', 'AI', '可调用工作流', false],
    ],
    chat: ['扩展连接中心', 'connect', '扩', '6 个已连接', 'tabler:plug-connected'],
    assistant: 'AI 助理',
    prompt: '@AI 助理，我想创建一个应用对接到即应怎么操作',
    processLabel: '正在查找中',
    response: '可以通过开放 API 创建应用并接入即应。',
    responseStatus: '已找到',
    streamResponse: false,
  },
];

const comparisonRows = [
  ['企业即时通讯', true, true, true, true, true, true, true],
  ['Web、桌面与移动端', true, true, true, true, true, true, true],
  ['私有化部署', true, false, true, false, false, true, true],
  ['核心产品代码开源', true, false, false, false, false, true, true],
  ['在线文档', true, true, true, true, true, false, false],
  ['目标管理', false, true, true, false, false, false, false],
  ['项目管理', true, true, true, false, false, false, false],
  ['任务管理', true, true, true, true, true, true, false],
  ['开放 API 与应用扩展', true, true, true, true, true, true, true],
  ['内置 AI 助手', true, true, true, true, true, false, false],
];

const faqs = [
  ['即应和飞书、钉钉等企业 IM 是什么关系？', '飞书和钉钉是成熟的大而全团队生态；即应聚焦于“助理优先”的 AI 原生协作模式，让 AI 以明确身份与员工同频工作，且支持完全私有化部署与开源二次开发。'],
  ['使用即应，我们的企业数据安全有保障吗？', '非常安全。即应支持全套代码私有化部署在企业自有服务器或云基础设施中。数据读取与操作均遵循企业权限隔离策略，关键动作必须经由人工二次确认，核心代码开源可随时审计。'],
  ['AI 助理“茉莉”具体能帮我们做什么？', '在授权范围内，茉莉可跨聊天与项目查询历史上下文、总结会议与讨论共识、结构化提取待办任务、智能起草通知与公文、自动追踪项目进展，并在需要决策时安全地将控制权交还给人。'],
  ['部署即应需要什么样的基础条件？', '即应采用容器化部署方案（提供 Docker / Compose 等依赖配置），支持 Web、桌面客户端（macOS / Windows / Linux）及移动端。您既可以在线体验 Demo，也可一键部署至私有服务器。'],
  ['即应是免费开源的吗？', '即应的核心产品代码基于 AGPL-3.0 许可证开源，支持企业与个人免费安装、使用和私有化部署。具体授权细则与商业支持可参阅 GitHub 官方发布说明。'],
  ['我们团队可以基于即应进行二次开发吗？', '完全可以！即应采用模块化架构与开源代码库，欢迎开发者根据自身业务需求定制 UI、扩展 Agent 插件或接入特定的企业工作流。'],
];

const asset = (name: string) => `${import.meta.env.BASE_URL}${name}`;
---

<BaseLayout title={title} description={description} schema={schema}>
  <SiteHeader />
  <main id="main-content" class="scene-page" style={`--scene-background: url('${asset('footer-meeting-room.webp')}')`}>
    <section class="scene scene-hero" aria-labelledby="hero-title">
      <div class="scene-shade scene-shade-heavy"></div>
      <div class="scene-content scene-content-bottom"><span class="scene-eyebrow">即应是什么</span><h1 id="hero-title"><span>即应</span>{' '}<span class="hero-title-accent">AI时代的团队协作入口</span></h1><p class="scene-lead">即应是一款开源的即时通讯工具，连接消息、知识与任务，让 Agent 深度融入工作流，成为真正能参与协作、推动执行的数字员工。</p><div class="scene-actions"><a class="scene-button scene-button-primary" href="https://app.jiying.chat/" target="_blank" rel="noopener noreferrer">在线体验 <Icon name="tabler:arrow-right" size={16} aria-hidden="true" /></a><a class="scene-button scene-button-outline" href="#download">免费安装 <Icon name="tabler:download" size={16} aria-hidden="true" /></a></div><div class="scene-tags"><span>开源</span><span>内置 AI 助理</span><span>支持私有化部署</span></div></div>
    </section>

    <section class="scene scene-why" id="why" aria-labelledby="why-title">
      <div class="scene-shade scene-shade-heavy"></div>
      <div class="scene-content scene-content-bottom"><div class="scene-text-block"><span class="scene-eyebrow">为什么需要即应</span><h2 id="why-title"><span class="title-line">AI 会回答问题，但</span><span class="title-line title-accent">工作仍由人来解决。</span></h2><p>在即应中不仅可以提供完整的团队协作能力，让沟通与执行在同一个空间完成。同时也内置了 AI 智能体能自然接入相关流程，让每个人都能轻松定义专属智能体，完成更多定制化工作。</p></div><section class="pain-carousel" data-pain-carousel aria-label="团队协作痛点轮播" aria-roledescription="carousel"><div class="pain-carousel-viewport"><div class="pain-carousel-track" data-pain-track>{painPoints.map(([number, itemTitle, body], index) => <article class="pain-banner" id={`pain-slide-${number}`} data-pain-slide role="group" aria-roledescription="slide" aria-label={`${index + 1} / ${painPoints.length}`} aria-hidden={index === 0 ? 'false' : 'true'}><div class="pain-banner-content"><p class="pain-banner-meta"><span>{number}</span><i></i><span>需求与痛点</span></p><h3>{itemTitle}</h3><p>{body}</p></div><span class="pain-banner-ordinal" aria-hidden="true">{number}</span></article>)}</div></div><div class="pain-carousel-controls"><div class="pain-carousel-pagination" role="tablist" aria-label="选择协作痛点">{painPoints.map(([number, itemTitle], index) => <button class:list={['pain-carousel-page', index === 0 && 'is-active']} type="button" role="tab" aria-selected={index === 0 ? 'true' : 'false'} aria-controls={`pain-slide-${number}`} data-pain-pagination={index} aria-label={`查看第 ${number} 项：${itemTitle}`} title={itemTitle}><span class="sr-only">{itemTitle}</span></button>)}</div><div class="pain-carousel-nav"><button class="pain-carousel-arrow pain-carousel-previous" type="button" data-pain-previous aria-label="查看上一项协作痛点" title="上一项"><Icon name="tabler:arrow-left" size={16} aria-hidden="true" /></button><button class="pain-carousel-arrow pain-carousel-next" type="button" data-pain-next aria-label="查看下一项协作痛点" title="下一项"><Icon name="tabler:arrow-right" size={16} aria-hidden="true" /></button></div></div></section></div>
    </section>

    <section class="scene scene-solution" id="solution" aria-labelledby="solution-title">
      <div class="scene-shade scene-shade-heavy"></div>
      <div class="scene-content scene-content-top scene-solution-content">
        <div class="scene-text-block"><span class="scene-eyebrow">功能介绍</span><h2 id="solution-title"><span class="title-line">一句话说出目标，</span><span class="title-line title-accent">剩下的交给 AI 助理</span></h2><p>即应希望 AI 不是与工作割裂的聊天机器人，而是能接手实际流程的数字员工——沟通、项目、时间、文档，处处替你分担；团队进展一目了然，人的精力回归真正重要的判断与创造。</p></div>
        <section class="feature-explorer" aria-label="即应核心能力">
          <div class="feature-previews">
            <article class="feature-preview-empty" data-feature-empty aria-label="即应团队工作台预览" hidden><div class="product-window"><div class="product-app"><aside class="app-dock" aria-hidden="true"><span class="app-dock-logo">即</span><Icon name="tabler:message-circle" size={14} /><Icon name="tabler:users" size={14} /><Icon name="tabler:checkbox" size={14} /></aside><aside class="app-inbox"><header><strong>消息</strong><Icon name="tabler:search" size={15} /></header><div class="app-inbox-tabs"><b>全部</b><span>未读</span><span>群聊</span></div><div class="app-thread"><i class="app-avatar app-avatar-assistant">AI</i><span><strong>AI 助理</strong><small>正在整理团队上下文</small></span></div><div class="app-thread"><i class="app-avatar app-avatar-team">团</i><span><strong>创新产品</strong><small>项目讨论与任务动态</small></span></div></aside><section class="app-chat app-chat-empty"><header><i class="app-avatar app-avatar-team">团</i><span><strong>创新产品</strong><small>15 人</small></span><Icon name="tabler:users" size={15} /></header><div class="app-chat-ghost" aria-hidden="true"><i></i><i></i><i></i></div><footer><span>输入消息</span><Icon name="tabler:send" size={14} /></footer></section></div></div></article>
            {capabilities.map(([itemTitle, body, label, icon, status], index) => <article class:list={['feature-preview-screen', `feature-preview-${index + 1}`, index === 0 && 'is-active']} id={`feature-preview-${index + 1}`} data-feature-preview={index} data-feature-prompt={featureVisuals[index].prompt} data-feature-process={featureVisuals[index].processLabel} data-feature-response={featureVisuals[index].response} data-feature-result={featureVisuals[index].responseStatus} data-feature-stream={featureVisuals[index].streamResponse} aria-label={label} hidden={index !== 0}><div class="product-window"><div class="product-app"><aside class="app-dock" aria-hidden="true"><span class="app-dock-logo">即</span><span class:list={['app-dock-item', index === 0 && 'is-current']}><Icon name="tabler:message-circle" size={14} /></span><span class:list={['app-dock-item', index === 1 && 'is-current']}><Icon name="tabler:checkbox" size={14} /></span><span class:list={['app-dock-item', index === 2 && 'is-current']}><Icon name="tabler:shield-check" size={14} /></span><span class:list={['app-dock-item', index === 3 && 'is-current']}><Icon name="tabler:plug-connected" size={14} /></span></aside><aside class="app-inbox"><header><strong>{featureVisuals[index].inboxTitle}</strong><Icon name="tabler:search" size={15} /></header><div class="app-inbox-tabs">{featureVisuals[index].inboxTabs.map((tab, tabIndex) => tabIndex === 0 ? <b>{tab}</b> : <span>{tab}</span>)}</div>{featureVisuals[index].threads.map(([threadName, avatar, avatarText, threadStatus, current]) => <div class:list={['app-thread', current && 'is-current']}><i class:list={['app-avatar', `app-avatar-${avatar}`]}>{avatarText}</i><span><strong>{threadName}</strong><small>{threadStatus}</small></span></div>)}</aside><section class="app-chat"><header><i class:list={['app-avatar', `app-avatar-${featureVisuals[index].chat[1]}`]}>{featureVisuals[index].chat[2]}</i><span><strong>{featureVisuals[index].chat[0]}</strong><small>{featureVisuals[index].chat[3]}</small></span><Icon name={featureVisuals[index].chat[4]} size={15} /></header><div class="app-chat-history"><time>今天 17:19</time><div class="app-message app-message-assistant" data-assistant-message><i class="app-avatar app-avatar-assistant">AI</i><div><small data-assistant-label>{featureVisuals[index].assistant}</small><article data-assistant-card><div class="app-message-heading"><Icon name={icon} size={14} /><strong>{label}</strong><b data-assistant-result>{status}</b></div><p data-assistant-response>{featureVisuals[index].response}</p>{index === 0 && <div class="app-context-sources"><span>客户反馈</span><span>项目看板</span><span>历史会话</span></div>}{index === 1 && <div class="app-task-list"><span><i></i>销售报表制作 <b>进行中</b></span><span><i></i>任务创建成功 <b>已完成</b></span></div>}{index === 2 && <div class="app-permission-list"><span><Icon name="tabler:eye" size={11} />读取上下文</span><span><Icon name="tabler:edit" size={11} />创建任务待确认</span></div>}{index === 3 && <div class="app-integration-list"><span><i></i>团队知识库 <b>已连接</b></span><span><i></i>模型服务 API <b>已连接</b></span></div>}</article></div></div><div class="app-message app-message-brief" data-user-message><i class="app-avatar app-avatar-user">你</i><div><small>你 · 刚刚</small><span data-user-request>{featureVisuals[index].prompt}</span></div></div><div class="app-typing" data-assistant-typing aria-label={`${featureVisuals[index].assistant} ${featureVisuals[index].processLabel}`}><span data-assistant-status>{featureVisuals[index].assistant} {featureVisuals[index].processLabel}</span><i></i><i></i><i></i></div></div><footer class="app-composer" data-feature-composer><span class="app-typing-text" data-composer-text>{featureVisuals[index].prompt}</span><span class="app-composer-send" data-send-control aria-hidden="true"><Icon name="tabler:send" size={14} /></span><span class="app-mouse-pointer" data-mouse-pointer aria-hidden="true"><Icon name="tabler:pointer-2" size={17} /></span></footer></section></div></div><div class="feature-preview-copy"><h3 class="feature-preview-title">{itemTitle}</h3><p>{body}</p></div></article>)}
          </div>
          <div class="feature-pagination" role="tablist" aria-label="选择核心能力">{capabilities.map(([itemTitle], index) => <button class:list={['feature-page', index === 0 && 'is-active']} type="button" role="tab" aria-selected={index === 0 ? 'true' : 'false'} aria-label={`查看第 ${index + 1} 项：${itemTitle}`} title={itemTitle} data-feature-page={index}></button>)}</div>
        </section>
      </div>
    </section>

    <section class="dual-section dual-section-comparison" id="capabilities" aria-labelledby="capability-title">
      <div class="scene-shade scene-shade-heavy"></div>
      <div class="comparison-inner" id="comparison">
        <div class="comparison-heading"><span class="scene-eyebrow">竞品对比</span><h2 id="capability-title">产品能力，一目了然</h2><p>围绕团队协作、部署方式与 AI 接入能力，快速了解即应与常见协作产品的覆盖范围。</p></div>
        <div class="comparison-panel comparison-panel-full" aria-label="同类产品对比">
          <div class="compare-wrap"><table class="compare-table"><thead><tr><th>比较维度</th><th class="jiying">即应</th><th>飞书</th><th>钉钉</th><th>企业微信</th><th>Slack</th><th>Mattermost</th><th>Rocket.Chat</th></tr></thead><tbody>{comparisonRows.map(([dimension, ...support]) => <tr><th>{dimension}</th>{support.map((supported, index) => <td class:list={[index === 0 && 'jiying']}><span class="sr-only">{supported ? '支持' : '不支持'}</span><Icon name={supported ? 'tabler:check' : 'tabler:x'} size={15} aria-hidden="true" /></td>)}</tr>)}</tbody></table></div>
          <p class="compare-note">对比基于各产品公开定位与常见使用方式整理；“私有化部署”指可部署到企业自有基础设施。具体能力可能随版本、套餐和企业配置变化。</p>
        </div>
      </div>
    </section>

    <section class="scene scene-faq" id="faq" aria-labelledby="faq-title">
      <div class="scene-shade scene-shade-heavy"></div>
      <div class="faq-inner">
        <div class="faq-heading"><span class="scene-eyebrow">FAQ</span><h2 id="faq-title">常见问题</h2><p class="faq-intro">从产品能力、部署方式到 AI 助理的使用边界，这里整理了团队最常关心的问题。</p></div>
        <div class="faq-list">{faqs.map(([question, answer]) => <details><summary>{question}<Icon name="tabler:arrow-right" size={17} aria-hidden="true" /></summary><p>{answer}</p></details>)}</div>
      </div>
    </section>

    <section class="scene scene-download" id="download" aria-labelledby="download-title">
      <div class="scene-shade scene-shade-heavy"></div>
      <div class="scene-content scene-content-center">
        <span class="scene-eyebrow">开始使用</span>
        <h2 id="download-title">下载安装</h2>
        <p class="download-intro">在线体验即刻进入工作空间，也可下载客户端或基于开源代码部署属于团队自己的即应。</p>
        <div class="download-links">
          <a class="download-link download-link-primary" href="https://app.jiying.chat/" target="_blank" rel="noopener noreferrer">
