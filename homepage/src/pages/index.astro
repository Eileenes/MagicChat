---
import { Icon } from 'astro-icon/components';
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteFooter from '../components/SiteFooter.astro';
import SiteHeader from '../components/SiteHeader.astro';

const title = '即应｜AI 时代的办公协作入口';
const description = '即应把团队沟通、办公 AI 助理、项目和任务放进同一个工作空间。让 AI 进入团队，把工作继续推进下去。';
const siteOrigin = Astro.site ?? Astro.url.origin;
const pageUrl = new URL(import.meta.env.BASE_URL, siteOrigin).href;
const logoUrl = new URL(`${import.meta.env.BASE_URL}favicon.webp`, siteOrigin).href;

const schema = [
  { '@context': 'https://schema.org', '@type': 'Organization', name: '即应', url: pageUrl, logo: logoUrl },
  { '@context': 'https://schema.org', '@type': 'SoftwareApplication', name: '即应', alternateName: 'MagicChat', applicationCategory: 'BusinessApplication', operatingSystem: 'Web, macOS, Windows, Linux, iOS, Android', description, url: pageUrl },
];

const painPoints = [
  ['01', '找人、找群难', '消息、文件、成员和项目各自分散。每次用 AI，都得先找到人，再重新寻找、复制和解释背景。'],
  ['02', '找记录、过程难', '普通 AI 一问一答，答完就结束。看不见联系人、会话和任务，也等不了别人的回复。'],
  ['03', '讨论和执行有断点', '共识还要人工整理成任务、通知负责人、追踪进展。沟通经常止于“收到”。'],
];

const workflow = [
  ['01', '提出目标', '接收“整理活动群合作意向”这类自然语言目标，识别主题、时间范围、涉及成员和希望的交付形式；不需要再填写复杂表单。'],
  ['02', '找到相关的人和会话', '根据目标在成员、群聊、项目和任务之间关联定位，先把与当前工作真正相关的上下文找全，再开始处理。'],
  ['03', '查询消息、文件和背景', '在授权范围内读取历史消息、附件、项目资料和执行记录，并把引用来源保留在会话中，方便随时回看依据。'],
  ['04', '总结已有共识', '合并重复信息，区分已经确认的事实、已经作出的决定和仍待确认的问题，避免把模糊讨论直接当成结论。'],
  ['05', '识别任务与风险', '从讨论里抽取待办、负责人、截止时间、卡点和依赖关系，形成能够继续推进的任务清单与风险提示。'],
  ['06', '检查重复项与权限', '在写入前检查是否已经存在同类任务，并确认当前用户是否拥有对应的读取和操作权限，避免重复创建或越权。'],
  ['07', '起草消息与计划', '为负责人生成提醒、群公告、任务描述和执行顺序；所有内容先作为草稿展示，方便团队按实际情况调整。'],
  ['08', '确认变更', '涉及创建任务、修改状态或发送消息时，茉莉会把对象、字段和影响范围完整列出，等待确认后再执行。'],
  ['09', '执行协作并等待回复', '确认后创建任务、联系成员、发送提醒；收到回复后继续沿用当前会话的上下文，而不是从头再问一遍。'],
  ['10', '交付并沉淀结果', '汇总完成情况，把任务卡片、结论和后续提醒回写到原会话，让下一次协作可以直接从已有结果继续。'],
];

const capabilities = [
  ['记得住', '上下文沉淀在会话、任务与执行记录里，不需要每次重新交代。'],
  ['会办事', '整理待办、起草消息、跟进进展，重要写入先征求确认。'],
  ['守边界', '只在授权范围内读取与操作，敏感信息与高风险动作始终可控。'],
];

const capabilityStages = ['理解团队上下文', '推进协作行动', '守住权限边界'];

const comparisonRows = [
  ['企业即时通讯', true, true, true, true, true, true, true],
  ['Web、桌面与移动端', true, true, true, true, true, true, true],
  ['私有化部署', true, false, true, false, false, true, true],
  ['核心产品代码开源', true, false, false, false, false, true, true],
  ['在线文档', true, true, true, true, true, false, false],
  ['目标管理', false, true, true, false, false, false, false],
  ['项目管理', true, true, true, false, false, false, false],
  ['任务管理', true, true, true, true, true, true, false],
  ['开放 API 与应用扩展', true, true, true, true, true, true, true],
  ['内置 AI 助手', true, true, true, true, true, false, false],
];

const faqs = [
  ['即应和飞书、钉钉是什么关系？', '它们是成熟的团队协作生态；即应聚焦于让 AI 以明确身份参与协作，并支持完全私有化部署，核心代码开源。'],
  ['用即应，我的数据安全吗？', '可部署到企业自有环境；数据读取与操作均受权限约束，关键写入需要人确认，核心代码开源可审计。'],
  ['茉莉能做什么？', '在授权范围内：查询历史信息、整理待办、起草与发送消息、创建和推进项目任务，并在需要判断时交还给人。'],
  ['需要什么基础才能用？', '支持 Web、桌面与移动端；可以先用在线 Demo 体验，再决定免费安装或私有化部署。'],
  ['是免费的吗？', '支持免费安装与私有化部署；具体授权方式以开源许可证（AGPL-3.0）及发布说明为准。'],
  ['我可以自己二次开发吗？', '可以，核心代码开源，并提供应用接入与扩展能力。'],
];

const asset = (name: string) => `${import.meta.env.BASE_URL}${name}`;
---

<BaseLayout title={title} description={description} schema={schema}>
  <SiteHeader />
  <main id="main-content" class="scene-page">
    <section class="scene scene-hero" aria-labelledby="hero-title">
      <img class="scene-image" src={asset('team-collaboration.webp')} alt="" aria-hidden="true" />
      <div class="scene-shade"></div>
      <div class="scene-content scene-content-bottom"><span class="scene-eyebrow">即应是什么</span><h1 id="hero-title">有事即应</h1><p class="scene-subtitle">AI 时代下的办公协作入口</p><p class="scene-lead">即应把团队沟通、办公 AI 助理、项目和任务放进同一个工作空间。AI 不只回答问题，也能在明确授权下查询信息、联系成员并执行工作。让 AI 进入团队，把工作继续推进下去。</p><div class="scene-actions"><a class="scene-button scene-button-primary" href="https://app.jiying.chat/" target="_blank" rel="noopener noreferrer">在线体验 <Icon name="tabler:arrow-right" size={16} aria-hidden="true" /></a><a class="scene-button scene-button-outline" href="#download">免费安装 <Icon name="tabler:download" size={16} aria-hidden="true" /></a></div><div class="scene-tags"><span>开源</span><span>内置 AI 助理茉莉</span><span>支持免费私有化部署</span></div></div>
    </section>

    <section class="scene scene-why" id="why" aria-labelledby="why-title">
      <img class="scene-image" src={asset('workspace-detail.webp')} alt="" aria-hidden="true" loading="lazy" /><div class="scene-shade scene-shade-heavy"></div>
      <div class="scene-content scene-content-bottom"><div class="scene-text-block"><span class="scene-eyebrow">为什么需要即应</span><h2 id="why-title">AI 已经会回答问题，<br /><em>工作却仍然由人来搬运</em></h2><p>真正的办公协作不只有一轮问答。它需要理解持续变化的上下文，找到正确的人，并把讨论推进到有结果。</p></div><div class="scene-rail">{painPoints.map(([number, itemTitle, body]) => <article class="scene-rail-item"><span>{number}</span><div><h3>{itemTitle}</h3><p>{body}</p></div><Icon name="tabler:arrow-right" size={18} aria-hidden="true" /></article>)}</div></div>
    </section>

    <section class="scene scene-solution" id="solution" aria-labelledby="solution-title">
      <img class="scene-image" src={asset('team-meeting.webp')} alt="" aria-hidden="true" loading="lazy" /><div class="scene-shade scene-shade-heavy"></div>
      <div class="scene-content scene-content-top"><div class="scene-text-block"><span class="scene-eyebrow">即应的解决方案</span><h2 id="solution-title"><span class="title-line">一句话说出目标，</span><span class="title-line title-line-accent">剩下的交给茉莉</span></h2><p>茉莉把查询、沟通和执行连接成同一段工作。每一步的依据和下一步动作，都在会话里清楚可见。</p></div><div class="workflow-panel"><div class="scene-flow-head"><span>真实工作流</span></div><div class="workflow-tabs" role="tablist" aria-label="真实工作流步骤">{workflow.map(([number, stepTitle], index) => <button class:list={['workflow-tab', index === 0 && 'is-active']} type="button" role="tab" aria-selected={index === 0 ? 'true' : 'false'} aria-controls={`workflow-panel-${number}`} data-workflow-tab={number}><span>{number}</span><strong>{stepTitle}</strong></button>)}</div><div class="workflow-cards">{workflow.map(([number, stepTitle, body], index) => <article class:list={['workflow-card', index === 0 && 'is-active']} id={`workflow-panel-${number}`} role="tabpanel" data-workflow-panel={number} hidden={index !== 0}><span class="workflow-card-number">{number}</span><div><p class="workflow-card-kicker">茉莉正在做什么</p><h3>{stepTitle}</h3><p>{body}</p></div><Icon name="tabler:arrow-right" size={22} aria-hidden="true" /></article>)}</div></div></div>
    </section>

    <section class="dual-section" id="capabilities" aria-labelledby="capability-title">
      <img class="dual-image" src={asset('capabilities-team.jpg')} alt="" aria-hidden="true" loading="lazy" />
      <div class="scene-shade scene-shade-heavy"></div>
      <div class="dual-inner">
        <div class="capability-panel">
          <span class="scene-eyebrow">核心能力</span>
          <h2 id="capability-title"><span class="title-line">茉莉不是工具栏，</span><span class="title-line title-line-accent">是团队里多了一位同事</span></h2>
          <p class="capability-intro">她读得懂你们的上下文，记得住谁在负责什么，也会在动手前把计划拿给你确认。</p>
          <div class="capability-cards">{capabilities.map(([itemTitle, body], index) => <article class="capability-card"><span class="capability-number">0{index + 1}</span><div><p class="capability-kicker">{capabilityStages[index]}</p><h3>{itemTitle}</h3><p>{body}</p></div></article>)}</div>
          <blockquote>“茉莉，发布的事跟到哪了？帮我把卡住的提醒一下。”</blockquote>
        </div>
        <div class="comparison-panel" id="comparison" aria-label="同类产品对比">
          <p class="panel-intro">即应更专注于让 AI 以明确身份进入团队并持续推进工作。</p>
          <div class="compare-wrap"><table class="compare-table"><thead><tr><th>比较维度</th><th class="jiying">即应</th><th>飞书</th><th>钉钉</th><th>企业微信</th><th>Slack</th><th>Mattermost</th><th>Rocket.Chat</th></tr></thead><tbody>{comparisonRows.map(([dimension, ...support]) => <tr><th>{dimension}</th>{support.map((supported, index) => <td class:list={[index === 0 && 'jiying']}><span class="sr-only">{supported ? '支持' : '不支持'}</span><Icon name={supported ? 'tabler:check' : 'tabler:x'} size={15} aria-hidden="true" /></td>)}</tr>)}</tbody></table></div>
          <p class="compare-note">对比基于各产品公开定位与常见使用方式整理；“私有化部署”指可部署到企业自有基础设施。具体能力可能随版本、套餐和企业配置变化。</p>
        </div>
      </div>
      <section class="dual-faq" aria-labelledby="faq-title">
        <div class="dual-faq-inner">
          <div class="dual-faq-heading"><span class="scene-eyebrow">FAQ</span><h2 id="faq-title">常见问题</h2></div>
          <div class="faq-list">{faqs.map(([question, answer]) => <details><summary>{question}<Icon name="tabler:arrow-right" size={17} aria-hidden="true" /></summary><p>{answer}</p></details>)}</div>
        </div>
      </section>
    </section>

    <section class="scene scene-download" id="download" aria-labelledby="download-title"><img class="scene-image" src={asset('download-meeting.jpg')} alt="" aria-hidden="true" loading="lazy" /><div class="scene-shade scene-shade-heavy"></div><div class="scene-content scene-content-center"><span class="scene-eyebrow">开始使用</span><h2 id="download-title">下载安装</h2><p>可以先用在线 Demo 体验，也可以免费安装到自己的设备或企业环境。</p><div class="download-links"><a class="download-link download-link-primary" href="https://app.jiying.chat/" target="_blank" rel="noopener noreferrer"><span><strong>在线体验</strong><small>直接进入即应工作空间</small></span><Icon name="tabler:arrow-right" size={20} aria-hidden="true" /></a><a class="download-link" href="https://github.com/chaitin/MagicChat/releases/latest" target="_blank" rel="noopener noreferrer"><span><strong>PC 端</strong><small>macOS / Windows / Linux</small></span><Icon name="tabler:download" size={20} aria-hidden="true" /></a><a class="download-link" href="#download"><span><strong>移动端</strong><small>iOS / Android · 即将支持</small></span><Icon name="tabler:device-mobile" size={20} aria-hidden="true" /></a><a class="download-link" href="https://github.com/chaitin/MagicChat" target="_blank" rel="noopener noreferrer"><span><strong>GitHub 源码</strong><small>AGPL-3.0 · 私有化部署</small></span><Icon name="tabler:brand-github-filled" size={20} aria-hidden="true" /></a></div></div></section>
  </main>
  <SiteFooter />
  <script>
    const revealItems = Array.from(new Set(Array.from(document.querySelectorAll<HTMLElement>('.scene-hero .scene-content > *, .scene-why .scene-text-block, .scene-why .scene-rail, .scene-solution .scene-text-block, .workflow-panel, .capability-panel > .scene-eyebrow, .capability-panel > h2, .capability-intro, .capability-cards, .capability-panel > blockquote, .comparison-panel, .dual-faq-inner, .scene-download .scene-content > *, .footer-grid > *'))));
    revealItems.forEach((item, index) => { item.classList.add('motion-reveal'); item.style.setProperty('--reveal-delay', `${(index % 5) * 70}ms`); });
    if ('IntersectionObserver' in window) { const observer = new IntersectionObserver((entries) => entries.forEach((entry) => { if (entry.isIntersecting) { entry.target.classList.add('is-visible'); observer.unobserve(entry.target); } }), { threshold: 0.16 }); revealItems.forEach((item) => observer.observe(item)); } else revealItems.forEach((item) => item.classList.add('is-visible'));
    const workflowTabs = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-workflow-tab]'));
    const workflowPanels = document.querySelectorAll<HTMLElement>('[data-workflow-panel]');
    let activeWorkflowIndex = 0;
    const showWorkflowStep = (index: number) => {
      activeWorkflowIndex = (index + workflowTabs.length) % workflowTabs.length;
      const activeTab = workflowTabs[activeWorkflowIndex];
      const step = activeTab.dataset.workflowTab;
      workflowTabs.forEach((item) => { const active = item === activeTab; item.classList.toggle('is-active', active); item.setAttribute('aria-selected', String(active)); });
      workflowPanels.forEach((panel) => { const active = panel.dataset.workflowPanel === step; panel.classList.toggle('is-active', active); panel.hidden = !active; });
    };
    workflowTabs.forEach((tab, index) => tab.addEventListener('click', () => showWorkflowStep(index)));
    if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches && workflowTabs.length > 1) window.setInterval(() => showWorkflowStep(activeWorkflowIndex + 1), 3000);
    if (window.matchMedia('(hover: hover)').matches) document.querySelectorAll<HTMLDetailsElement>('.faq-list details').forEach((item) => {
      item.addEventListener('mouseenter', () => { item.open = true; });
      item.addEventListener('mouseleave', () => { if (!item.matches(':focus-within')) item.open = false; });
    });
  </script>
</BaseLayout>
