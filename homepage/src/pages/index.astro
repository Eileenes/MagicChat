          <a class="download-link" href="https://github.com/chaitin/MagicChat" target="_blank" rel="noopener noreferrer">
            <span><strong>GitHub 源码</strong><small>AGPL-3.0 · 私有化部署</small></span>
            <Icon name="tabler:brand-github-filled" size={20} aria-hidden="true" />
          </a>
