---
import {
  ArrowDown,
  ArrowRight,
  Bot,
  Check,
  FileText,
  FolderKanban,
  ListTodo,
  MessageCircle,
  Mic,
  Paperclip,
  Search,
  Send,
  ShieldCheck,
  Sparkles,
  Users,
} from '@lucide/astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteFooter from '../components/SiteFooter.astro';
import SiteHeader from '../components/SiteHeader.astro';

const title = '即应｜让每个人拥有自己的 AI 工作助理';
const description = '即应是面向企业团队的 AI 工作入口。个人助理茉莉帮助理解消息、整理上下文、提取任务，让沟通自然走向行动。';
const siteOrigin = Astro.site ?? Astro.url.origin;
const pageUrl = new URL(import.meta.env.BASE_URL, siteOrigin).href;
const logoUrl = new URL(`${import.meta.env.BASE_URL}favicon.webp`, siteOrigin).href;

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    name: '即应',
    url: pageUrl,
    logo: logoUrl,
    sameAs: ['https://github.com/duke-yeah/MagicChat'],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'SoftwareApplication',
    name: '即应',
    alternateName: 'MagicChat',
    applicationCategory: 'BusinessApplication',
    operatingSystem: 'Web, macOS, Windows, Linux, iOS, Android',
    description,
    url: pageUrl,
  },
];

const capabilities = [
  {
    number: '01',
    label: '持续上下文',
    title: '消息、文件和结论留在同一处',
    body: '从私聊、群聊到项目任务，相关背景持续沉淀。团队不必在不同工具之间反复转述。',
    icon: MessageCircle,
    tone: 'teal',
  },
  {
    number: '02',
    label: '人机协作',
    title: '茉莉先整理，重要判断由你确认',
    body: 'AI 助理负责阅读、归纳和草拟；涉及范围、权限与决策时，再带着完整原因交还给人。',
    icon: Sparkles,
    tone: 'violet',
  },
  {
    number: '03',
    label: '行动闭环',
    title: '讨论自然落到项目和任务',
    body: '把共识转成有负责人、状态和截止时间的事项，让每一步都清晰、可追踪。',
    icon: ListTodo,
    tone: 'coral',
  },
];

const steps = [
  ['01', '提出请求', '团队成员在会话中说明目标，消息、文件和讨论自动成为工作背景。'],
  ['02', '茉莉整理', 'AI 助理提炼重点、补齐上下文，给出摘要、草稿或下一步建议。'],
  ['03', '团队确认', '需要判断的部分交给对应负责人，确认结果继续留在原有上下文中。'],
  ['04', '持续推进', '结论进入项目与任务，负责人、状态和截止时间清楚可见。'],
];
---

<BaseLayout title={title} description={description} schema={schema}>
  <SiteHeader />
  <main id="main-content">
    <section class="hero" aria-labelledby="hero-title">
      <div class="container hero-grid">
        <div class="hero-copy">
          <span class="eyebrow"><span class="status-dot"></span>个人 AI 工作助理</span>
          <h1 id="hero-title">有事即应，<br /><mark>茉莉来帮你</mark></h1>
          <p>即应把团队沟通、AI 助理、项目与任务放在同一个工作空间。茉莉先理解消息和上下文，再把需要判断的部分交还给你。</p>
          <div class="hero-actions">
            <a class="button button-primary" href="https://chat.chaitin.net/" target="_blank" rel="noreferrer">
              开始使用 <ArrowRight size={17} aria-hidden="true" />
            </a>
            <a class="button button-secondary" href="#product">
              了解即应 <ArrowDown size={17} aria-hidden="true" />
            </a>
          </div>
          <ul class="hero-points" aria-label="产品原则">
            <li><Check size={14} aria-hidden="true" /> 消息有人接住</li>
            <li><Check size={14} aria-hidden="true" /> 上下文持续沉淀</li>
            <li><Check size={14} aria-hidden="true" /> 重要决策由人确认</li>
          </ul>
        </div>

        <div class="product-scene" aria-label="即应产品界面示意图">
          <div class="product-window">
            <aside class="app-rail" aria-hidden="true">
              <img src={`${import.meta.env.BASE_URL}favicon.webp`} width="34" height="34" alt="" />
              <span class="rail-icon active"><MessageCircle size={16} /></span>
              <span class="rail-icon"><Users size={16} /></span>
              <span class="rail-icon"><FolderKanban size={16} /></span>
              <span class="rail-avatar">你</span>
            </aside>
            <aside class="conversation-list" aria-hidden="true">
              <strong>协作空间</strong>
              <div class="mock-search"><Search size={12} /> 搜索会话</div>
              <small>置顶会话</small>
              <div class="conversation active"><span class="avatar ai">茉</span><div><b>茉莉</b><em>已整理今天的待办</em></div></div>
              <div class="conversation"><span class="avatar violet">产</span><div><b>产品研发群</b><em>林夏：收到</em></div></div>
              <div class="conversation"><span class="avatar coral">设</span><div><b>设计评审</b><em>2 个新文件</em></div></div>
            </aside>
            <section class="chat-panel" aria-hidden="true">
              <header><div><b>茉莉</b><small>你的个人 AI 工作助理</small></div><span class="online">在线</span></header>
              <div class="message-flow">
                <div class="message assistant-message">
                  <span class="avatar ai">茉</span>
                  <div><small>茉莉 · 09:42</small><p>我整理了产品研发群里与本周发布有关的讨论，目前有 3 项待办。</p></div>
                </div>
                <div class="task-summary">
                  <div class="task-heading"><span><FileText size={13} /> 发布准备</span><b>3 项</b></div>
                  <div class="task-row"><Check size={12} /> 确认桌面端发布范围 <span>已完成</span></div>
                  <div class="task-row"><span class="task-open"></span> 补齐更新说明 <span>今天</span></div>
                  <div class="task-row"><span class="task-open"></span> 完成多端回归 <span>周五</span></div>
                </div>
                <div class="message user-message"><div><small>你 · 09:44</small><p>把后两项建成任务，负责人沿用群里的分工。</p></div></div>
              </div>
              <div class="composer">给茉莉发消息… <span><Paperclip size={13} /><Mic size={13} /><i><Send size={12} /></i></span></div>
            </section>
          </div>
        </div>
      </div>
    </section>

    <div class="overview-bar" aria-label="即应产品概览">
      <div class="container overview-grid">
        <div><strong>会话</strong><span>沟通集中，不丢背景</span></div>
        <div><strong>茉莉</strong><span>先整理，再请你判断</span></div>
        <div><strong>项目与任务</strong><span>结论清楚，持续推进</span></div>
      </div>
    </div>

    <section class="section product-section" id="product">
      <div class="container">
        <div class="section-heading reveal">
          <div><span class="eyebrow">产品体验</span><h2>从一条消息，<br />到一个明确结果</h2></div>
          <p>讨论留在会话，茉莉整理上下文，项目与任务承接下一步。每个环节共享同一份背景。</p>
        </div>

        <div class="product-demo reveal">
          <div class="demo-tabs" role="tablist" aria-label="即应产品能力">
            <button class="demo-tab active" type="button" role="tab" aria-selected="true" aria-controls="demo-chat" data-demo="chat">会话协作</button>
            <button class="demo-tab" type="button" role="tab" aria-selected="false" aria-controls="demo-agent" data-demo="agent">茉莉</button>
            <button class="demo-tab" type="button" role="tab" aria-selected="false" aria-controls="demo-project" data-demo="project">项目与任务</button>
          </div>
          <div class="demo-panels">
            <article class="demo-panel active" id="demo-chat" role="tabpanel" data-panel="chat">
              <div class="demo-copy"><span>01 · 会话协作</span><h3>沟通集中，上下文不散落</h3><p>私聊、群聊和话题统一承载文字、文件、图片和语音。重要信息留在讨论发生的地方。</p><ul><li>私聊与群聊</li><li>话题讨论</li><li>多类型消息</li></ul></div>
              <div class="demo-visual"><div class="topic-ui"><b># 产品上线准备</b><div><span class="avatar violet">林</span><p><strong>林夏</strong>桌面端发布范围已经确认，更新说明还差最后一版。</p></div><div><span class="avatar ai">茉</span><p><strong>茉莉</strong>我可以根据本次变更记录先整理一份草稿。</p></div><label>回复当前话题…</label></div></div>
            </article>
            <article class="demo-panel" id="demo-agent" role="tabpanel" data-panel="agent" hidden>
              <div class="demo-copy"><span>02 · 茉莉</span><h3>先整理信息，再请你判断</h3><p>茉莉在会话上下文中总结、草拟和归纳。需要确认时，她会说明原因、影响与下一步。</p><ul><li>个人工作助理</li><li>团队 AI 应用</li><li>权限边界</li></ul></div>
              <div class="demo-visual"><div class="agent-list"><div><span class="agent-face teal"><Sparkles size={18} /></span><p><b>茉莉</b><small>你的个人 AI 工作助理</small></p><em>在线</em></div><div><span class="agent-face violet"><Bot size={18} /></span><p><b>知识助手</b><small>在会话中检索团队知识</small></p><em>全员可见</em></div><div><span class="agent-face coral"><Bot size={18} /></span><p><b>运营助手</b><small>整理活动执行信息</small></p><em>运营组可见</em></div></div></div>
            </article>
            <article class="demo-panel" id="demo-project" role="tabpanel" data-panel="project" hidden>
              <div class="demo-copy"><span>03 · 项目与任务</span><h3>讨论有归属，行动有负责人</h3><p>会话关联项目，任务明确负责人、状态和截止时间，让团队始终知道下一步。</p><ul><li>项目关联会话</li><li>任务状态</li><li>到期提醒</li></ul></div>
              <div class="demo-visual"><div class="mini-board"><section><b>待处理 <em>2</em></b><p>补齐上线说明<small>今天 · 林夏</small></p><p>检查下载页<small>周四 · 陈屿</small></p></section><section><b>进行中 <em>1</em></b><p>发布前回归测试<small>周五 · QA</small></p></section><section><b>已完成 <em>1</em></b><p>确认版本范围<small>今天 · 完成</small></p></section></div></div>
            </article>
          </div>
        </div>
      </div>
    </section>

    <section class="section capability-section" id="capabilities">
      <div class="container">
        <div class="section-heading reveal">
          <div><span class="eyebrow">核心能力</span><h2>一条连续、清晰的<br />团队工作路径</h2></div>
          <p>即应不增加新的信息孤岛，而是让沟通、AI 协作和执行共享上下文。</p>
        </div>
        <div class="capability-grid">
          {capabilities.map(({ number, label, title: itemTitle, body, icon: Icon, tone }, index) => (
            <article class:list={['capability-card', tone, 'reveal']} style={`--delay: ${index * 70}ms`}>
              <div class="card-top"><span>{number} · {label}</span><Icon size={24} stroke-width={1.8} aria-hidden="true" /></div>
              <div><h3>{itemTitle}</h3><p>{body}</p></div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="section workflow-section" id="workflow">
      <div class="container">
        <div class="section-heading reveal">
          <div><span class="eyebrow">协作方式</span><h2>从提出请求，<br />到持续推进</h2></div>
          <p>茉莉处理重复的信息工作，团队保留关键判断权，项目与任务负责承接结果。</p>
        </div>
        <div class="workflow-layout">
          <aside class="workflow-note reveal"><span class="note-icon"><MessageCircle size={22} /></span><h3>沟通不是终点</h3><p>每次讨论都可以继续成为工作的下一步，而不需要离开当前上下文重新开始。</p><div><span>消息</span><ArrowRight size={13} /><span>整理</span><ArrowRight size={13} /><span>确认</span><ArrowRight size={13} /><span>行动</span></div></aside>
          <div class="workflow-steps">
            {steps.map(([number, stepTitle, body], index) => (
              <article class="workflow-step reveal" style={`--delay: ${index * 70}ms`}><span>{number}</span><div><h3>{stepTitle}</h3><p>{body}</p></div></article>
            ))}
          </div>
        </div>
      </div>
    </section>

    <section class="section assistant-section" id="assistant">
      <div class="container assistant-band reveal">
        <div class="assistant-copy"><span class="eyebrow eyebrow-light">个人 AI 助理 · 茉莉</span><h2>需要你介入时，<br />信息已经准备好</h2><p>茉莉会说明为什么现在找你、为什么由你判断、需要做什么，以及不处理会有什么影响。</p><div class="trust-points"><span><ShieldCheck size={17} /> 权限边界清晰</span><span><FileText size={17} /> 上下文完整</span></div></div>
        <aside class="decision-panel" aria-label="茉莉发起的确认请求示例">
          <header><span><span class="assistant-avatar">茉</span> 茉莉的确认请求</span><em>需要确认</em></header>
          <h3>发布范围存在一项待确认风险</h3>
          <dl><div><dt>为什么现在找我？</dt><dd>回归测试发现权限策略与发布范围不一致。</dd></div><div><dt>为什么由我判断？</dt><dd>你是当前版本的项目负责人。</dd></div><div><dt>我需要做什么？</dt><dd>确认缩小范围，或授权按原计划继续。</dd></div></dl>
          <div class="decision-actions"><button type="button">查看详情</button><button type="button">确认缩小范围</button></div>
        </aside>
      </div>
    </section>
  </main>
  <SiteFooter />

  <script>
    const tabs = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-demo]'));
    const panels = Array.from(document.querySelectorAll<HTMLElement>('[data-panel]'));
    tabs.forEach((tab) => {
      tab.addEventListener('click', () => {
        const target = tab.dataset.demo;
        tabs.forEach((item) => {
          const active = item === tab;
          item.classList.toggle('active', active);
          item.setAttribute('aria-selected', String(active));
        });
        panels.forEach((panel) => {
          const active = panel.dataset.panel === target;
          panel.classList.toggle('active', active);
          panel.hidden = !active;
        });
      });
    });

    const revealItems = document.querySelectorAll<HTMLElement>('.reveal');
    if (!('IntersectionObserver' in window)) {
      revealItems.forEach((item) => item.classList.add('visible'));
    } else {
      const observer = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          entry.target.classList.add('visible');
          observer.unobserve(entry.target);
        });
      }, { threshold: 0.12, rootMargin: '0px 0px -36px' });
      revealItems.forEach((item) => observer.observe(item));
    }
  </script>
</BaseLayout>
