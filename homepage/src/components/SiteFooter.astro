---
const year = new Date().getFullYear();
---

<footer class="site-footer" style={`--footer-image: url('${import.meta.env.BASE_URL}footer-collaboration.jpg')`}>
  <div class="container footer-grid">
    <div class="footer-intro-block">
      <a class="brand brand-light" href={import.meta.env.BASE_URL} aria-label="即应官网首页">
        <img src={`${import.meta.env.BASE_URL}favicon.webp`} width="34" height="34" alt="" />
        <span>即应</span>
      </a>
      <p class="footer-slogan">让 AI 进入团队，把工作继续推进下去。</p>
      <p class="footer-intro">开源的企业 AI 工作空间。</p>
    </div>
    <div class="footer-column">
      <h2>资源</h2>
      <a href="https://github.com/chaitin/MagicChat#readme" target="_blank" rel="noopener noreferrer">产品文档</a>
      <a href="https://github.com/chaitin/MagicChat" target="_blank" rel="noopener noreferrer">GitHub 仓库</a>
    </div>
    <div class="footer-column">
      <h2>关于我们</h2>
      <a href="https://www.chaitin.cn/" target="_blank" rel="noopener noreferrer">长亭科技</a>
      <a href="https://www.baizhi.cloud/" target="_blank" rel="noopener noreferrer">长亭百智云</a>
      <a href="https://www.chaitin.cn/" target="_blank" rel="noopener noreferrer">长亭 Agent 运行编排平台</a>
      <a href={`${import.meta.env.BASE_URL}privacy/`}>隐私政策</a>
      <span>用户协议</span>
    </div>
    <div class="footer-community">
      <h2>技术交流群</h2>
      <div class="community-qr-list">
        <figure class="community-qr">
          <img src={`${import.meta.env.BASE_URL}wecom-community-qr.png`} width="396" height="396" alt="企业微信交流群二维码" loading="lazy" />
          <figcaption>企业微信交流群</figcaption>
        </figure>
        <figure class="community-qr">
          <img src={`${import.meta.env.BASE_URL}feishu-community-qr.png`} width="578" height="578" alt="飞书交流群二维码" loading="lazy" />
          <figcaption>飞书交流群</figcaption>
        </figure>
      </div>
    </div>
  </div>
  <div class="container footer-bottom">
    <p>京ICP备2024055124号-17</p>
    <p>© {year} MagicChat · 版权所有：北京长亭科技有限公司 · 本应用由 MagicChat 开发</p>
  </div>
</footer>
