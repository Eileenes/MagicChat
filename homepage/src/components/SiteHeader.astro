---
import { Icon } from 'astro-icon/components';
---

<header class="site-header">
  <div class="container nav-shell">
    <a class="brand" href={import.meta.env.BASE_URL} aria-label="即应官网首页">
      <img src={`${import.meta.env.BASE_URL}favicon.webp`} width="36" height="36" alt="" />
      <span>即应</span>
    </a>
    <nav class="header-actions" aria-label="快捷入口">
      <a class="header-icon" href="https://github.com/chaitin/MagicChat" target="_blank" rel="noopener noreferrer" aria-label="在 GitHub 查看即应源码" title="GitHub">
        <Icon name="tabler:brand-github-filled" size={19} aria-hidden="true" />
      </a>
      <a class="header-icon" href={`${import.meta.env.BASE_URL}#download`} aria-label="跳转到下载区域" title="下载即应">
        <Icon name="tabler:download" size={19} aria-hidden="true" />
      </a>
    </nav>
  </div>
</header>
