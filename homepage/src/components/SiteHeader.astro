---
import { ArrowUpRight, Menu, X } from '@lucide/astro';
---

<header class="site-header">
  <div class="container nav-shell">
    <a class="brand" href={import.meta.env.BASE_URL} aria-label="即应官网首页">
      <img src={`${import.meta.env.BASE_URL}logo.webp`} width="36" height="36" alt="" />
      <span>即应</span>
    </a>
    <nav class="desktop-nav" aria-label="主导航">
      <a href={`${import.meta.env.BASE_URL}#product`}>产品</a>
      <a href={`${import.meta.env.BASE_URL}#capabilities`}>能力</a>
      <a href={`${import.meta.env.BASE_URL}#workflow`}>协作方式</a>
      <a href={`${import.meta.env.BASE_URL}#assistant`}>茉莉</a>
    </nav>
    <a class="button button-dark nav-cta" href="https://chat.chaitin.net/" target="_blank" rel="noreferrer">
      打开即应 <ArrowUpRight size={16} aria-hidden="true" />
    </a>
    <button class="icon-button menu-trigger" type="button" aria-label="打开导航" aria-expanded="false" aria-controls="mobile-menu">
      <Menu class="menu-open-icon" size={22} aria-hidden="true" />
      <X class="menu-close-icon" size={22} aria-hidden="true" />
    </button>
  </div>
  <nav class="mobile-nav" id="mobile-menu" aria-label="移动端导航" hidden>
    <a href={`${import.meta.env.BASE_URL}#product`}>产品</a>
    <a href={`${import.meta.env.BASE_URL}#capabilities`}>能力</a>
    <a href={`${import.meta.env.BASE_URL}#workflow`}>协作方式</a>
    <a href={`${import.meta.env.BASE_URL}#assistant`}>茉莉</a>
    <a href="https://chat.chaitin.net/" target="_blank" rel="noreferrer">打开即应</a>
  </nav>
</header>

<script>
  const trigger = document.querySelector<HTMLButtonElement>('.menu-trigger');
  const menu = document.querySelector<HTMLElement>('#mobile-menu');
  const close = () => {
    if (!trigger || !menu) return;
    trigger.setAttribute('aria-expanded', 'false');
    trigger.setAttribute('aria-label', '打开导航');
    menu.hidden = true;
  };

  trigger?.addEventListener('click', () => {
    if (!menu) return;
    const expanded = trigger.getAttribute('aria-expanded') === 'true';
    trigger.setAttribute('aria-expanded', String(!expanded));
    trigger.setAttribute('aria-label', expanded ? '打开导航' : '关闭导航');
    menu.hidden = expanded;
  });
  menu?.querySelectorAll('a').forEach((link) => link.addEventListener('click', close));
</script>
