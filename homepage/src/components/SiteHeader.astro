---
import { Icon } from 'astro-icon/components';
---

<header class="site-header">
  <div class="container nav-shell">
    <a class="brand" href={import.meta.env.BASE_URL} aria-label="即应官网首页">
      <img src={`${import.meta.env.BASE_URL}favicon.webp`} width="36" height="36" alt="" />
      <span>即应</span>
    </a>
    <a
      class="button button-secondary header-github"
      href="https://github.com/chaitin/MagicChat"
      target="_blank"
      rel="noopener noreferrer"
      aria-label="GitHub"
    >
      <Icon name="tabler:brand-github-filled" size={20} aria-hidden="true" />
    </a>
  </div>
</header>
